INIT:

ENDI
KB:

KBI
EXIT:
IF(CharacterLevelGreaterThan(3) and not CharacterLevelGreaterThan(7)):SpellSaveDC(1);
IF(CharacterLevelGreaterThan(7) and not CharacterLevelGreaterThan(11)):SpellSaveDC(2);
IF(CharacterLevelGreaterThan(11) and not CharacterLevelGreaterThan(15)):SpellSaveDC(3);
IF(CharacterLevelGreaterThan(15)):SpellSaveDC(4);
IF(CharacterLevelGreaterThan(3) and not CharacterLevelGreaterThan(4)):ActionResourceOverride(SpellSlot,2,3);
IF(CharacterLevelGreaterThan(4) and not CharacterLevelGreaterThan(10)):ActionResourceOverride(SpellSlot,3,3);
IF(CharacterLevelGreaterThan(10)):ActionResourceOverride(SpellSlot,4,3);
IF(CharacterLevelGreaterThan(5) and not CharacterLevelGreaterThan(6)):ActionResourceOverride(SpellSlot,1,4);
IF(CharacterLevelGreaterThan(6) and not CharacterLevelGreaterThan(11)):ActionResourceOverride(SpellSlot,2,4);
IF(CharacterLevelGreaterThan(11)):ActionResourceOverride(SpellSlot,3,4);
IF(CharacterLevelGreaterThan(7) and not CharacterLevelGreaterThan(8)):ActionResourceOverride(SpellSlot,1,5);
IF(CharacterLevelGreaterThan(8) and not CharacterLevelGreaterThan(12)):ActionResourceOverride(SpellSlot,2,5);
IF(CharacterLevelGreaterThan(12)):ActionResourceOverride(SpellSlot,3,5);
IF(CharacterLevelGreaterThan(9) and not CharacterLevelGreaterThan(13)):ActionResourceOverride(SpellSlot,1,6);
IF(CharacterLevelGreaterThan(13)):ActionResourceOverride(SpellSlot,2,6);

// Warlock
